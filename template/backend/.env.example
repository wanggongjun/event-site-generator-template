# Copy to a git-ignored .env.production or configure deployment Secrets.
# No credentials belong in XLSX, config.json, chats, documents, or GitHub.
APP_MODE=real
NODE_ENV=production
PUBLIC_ORIGIN=https://event.example.org
HOST=0.0.0.0
PORT=3000
SYNC_POLL_SECONDS=60
# Provide the independent database through your deployment secret manager:
DATABASE_URL=postgresql://event_user:REPLACE_IN_SECRET_MANAGER@127.0.0.1:5432/event_business
# APP_ROOT is optional; defaults to the generated instance root.

# Native Aliyun SMS (default). No SMS is sent by check.js:
SMS_PROVIDER=aliyun
SMS_ALIYUN_ACCESS_KEY_ID=REPLACE_IN_SECRET_MANAGER
SMS_ALIYUN_ACCESS_KEY_SECRET=REPLACE_IN_SECRET_MANAGER
SMS_ALIYUN_SIGN_NAME=REPLACE_WITH_APPROVED_SIGN
SMS_ALIYUN_TEMPLATE_CODE=REPLACE_WITH_APPROVED_TEMPLATE
SMS_ALIYUN_TEMPLATE_PARAM_KEY=code
# Optional gateway instead: SMS_PROVIDER=http, HTTPS SMS_SEND_URL, SMS_API_KEY,
# optional SMS_TEMPLATE_ID. Only use the explicitly authorized provider.

FEISHU_MODE=real
FEISHU_APP_ID=REPLACE_WITH_EXISTING_APP_ID
FEISHU_APP_SECRET=REPLACE_IN_SECRET_MANAGER
FEISHU_BITABLE_URL=https://your-tenant.feishu.cn/base/REPLACE_WITH_TARGET_BASE
# plan resolves the target; apply saves non-secret IDs to .env.feishu.ids.
# You can instead supply exact known IDs (three distinct compatible tables):
# FEISHU_BITABLE_APP_TOKEN=...
# FEISHU_ATTENDANCE_TABLE_ID=...
# FEISHU_SUBMISSION_TABLE_ID=...
# FEISHU_QUESTION_TABLE_ID=...

# Local development requires npm run dev:simulation explicitly.
# NODE_ENV=production never permits simulation. Local CLI code/reviews require
# APP_MODE=simulation and DATABASE_URL naming that same local test database.
