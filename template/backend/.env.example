# Runtime-only settings. Do not copy any secrets into event config.json.
APP_MODE=simulation
APP_ROOT=/absolute/path/to/generated-event
# Omit DATABASE_URL in simulation to start persistent local PostgreSQL automatically.
# DATABASE_URL=postgresql://event_user:REPLACE_PASSWORD@127.0.0.1:5432/event_business
PUBLIC_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
SYNC_POLL_SECONDS=60
# Real mode requires HTTPS origin + real SMS + real Feishu. Live calls are untested.
# APP_MODE=real
# PUBLIC_ORIGIN=https://event.example.org
# HOST=0.0.0.0
# SMS_PROVIDER=aliyun
# SMS_ALIYUN_ACCESS_KEY_ID=...
# SMS_ALIYUN_ACCESS_KEY_SECRET=...
# SMS_ALIYUN_SIGN_NAME=...
# SMS_ALIYUN_TEMPLATE_CODE=...
# SMS_ALIYUN_TEMPLATE_PARAM_KEY=code
# SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
# SMS_ALIYUN_REGION_ID=cn-hangzhou
# Optional gateway alternative, explicitly choose SMS_PROVIDER=http instead:
# SMS_SEND_URL=https://your-sms-gateway.example.org/send
# SMS_API_KEY=...
# SMS_TEMPLATE_ID=...
# FEISHU_MODE=real
# FEISHU_APP_ID=...
# FEISHU_APP_SECRET=...
# FEISHU_BITABLE_APP_TOKEN=...
# FEISHU_ATTENDANCE_TABLE_ID=...
# FEISHU_SUBMISSION_TABLE_ID=...
