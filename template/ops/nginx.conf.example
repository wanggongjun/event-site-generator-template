# Replace event-staging.example.org, certificate paths and 3310 for this environment only.
server {
    listen 80;
    server_name event-staging.example.org;
    return 308 https://event-staging.example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name event-staging.example.org;
    ssl_certificate /etc/letsencrypt/live/event-staging.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/event-staging.example.org/privkey.pem;
    client_max_body_size 30m;
    location / {
        proxy_pass http://127.0.0.1:3310;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 90s;
    }
}
