{
  "name": "event-frontend",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:state": "vite build --ssr test/session-state.tsx --outDir ../.frontend-test-build && node ../.frontend-test-build/session-state.js",
    "test:pages": "vite build --ssr test/render-pages.tsx --outDir ../.page-test-build"
  },
  "dependencies": {
    "liquid-glass-react": "1.1.1",
    "lucide-react": "0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
